# Build output
**/dist/
**/target/
**/.gradle/
**/build/

# Dependencies
**/node_modules/

# Local environment and machine configuration
.env
.env.*
!.env.example
**/local.properties

# Logs and operating-system files
*.log
.DS_Store

**/__pycache__/
*.pyc
build/
dist/

# The cinematic backdrop is generated once into videos/ and copied into the
# app at build time; the copy is a build artifact, not a second source of truth.
apps/ai-red-team-web/public/video/
# The films packed with their depth are derived from those films by
# scripts/build-redteam-depth.py, so they are build artifacts too. The depth
# stills, depth-hashes.json and src/media/depth.ts are tracked.
apps/ai-red-team-web/public/media/depth/*.mp4

# Transient H3 generation working state (task ids, query args, temp URLs).
.tmp/

# Intermediate H3 reference derivatives and the extracted drone: regenerable
# from the source clips, and large. The prompt that produced the backdrop is
# kept next to the video in videos/.
prepared-media/
