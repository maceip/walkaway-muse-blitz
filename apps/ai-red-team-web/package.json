{
  "name": "@walkaway/ai-red-team-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AI Red Team \u2014 the redteam.model.tools surface. React + Vite, served as static build behind a dependency-free Node server.",
  "license": "BSD-3-Clone",
  "scripts": {
    "dev": "python3 ../../scripts/build-redteam-media.py && vite",
    "build": "python3 ../../scripts/build-redteam-media.py && python3 ../../scripts/build-redteam-depth.py --check && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
