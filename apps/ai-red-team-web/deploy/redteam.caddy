# redteam.model.tools and red.model.tools — the AI Red Team surface.
#
# Both hostnames serve the same page: redteam-web.service on 127.0.0.1:8091.
# The app terminates nothing itself, TLS is handled here.
#
# DNS must be: A red.model.tools -> 20.114.5.117
#             A redteam.model.tools -> 20.114.5.117
#
# Two rules this box has taught us the hard way:
#   - The global Caddyfile sets `admin off`, so `caddy reload` can never reach
#     the running instance. A change here needs `systemctl restart caddy`.
#   - Never give a stanza a file access log under /var/log/caddy: the caddy
#     user cannot create files there and the unit crash-loops, taking every
#     site on the box down. Logs go to stdout, like swarm.caddy.
(redteam_web) {
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=86400"
		-Server
		-Via
		-X-Powered-By
		-X-Runtime
		-X-Version
	}

	reverse_proxy 127.0.0.1:8091

	log
}

redteam.model.tools {
	import redteam_web
}

red.model.tools {
	import redteam_web
}
