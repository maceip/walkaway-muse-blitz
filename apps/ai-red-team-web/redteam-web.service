# The AI Red Team surface: redteam.model.tools (and red.model.tools, which
# redirects here). Caddy terminates TLS and proxies to 127.0.0.1:8091.
[Unit]
Description=AI Red Team web (redteam.model.tools)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=true
WorkingDirectory=/opt/redteam-web/current
ExecStart=/usr/local/bin/node server/index.mjs
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8091
Restart=always
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64
UMask=0027

[Install]
WantedBy=multi-user.target
